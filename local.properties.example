# Agente de IA (opcional: también se puede configurar dentro de la app, botón "IA")
# AI_PROVIDER: anthropic (por defecto) u openai (cualquier API compatible con OpenAI)
AI_PROVIDER=
# URL base. Ejemplos: https://api.anthropic.com | https://api.openai.com/v1
# https://generativelanguage.googleapis.com/v1beta/openai | https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
# Nombre exacto del modelo del proveedor (por defecto en Anthropic: claude-sonnet-5-5)
AI_MODEL=
# Compatibilidad anterior: si AI_API_KEY está vacío se usa ANTHROPIC_KEY
ANTHROPIC_KEY=
PICOVOICE_KEY=
